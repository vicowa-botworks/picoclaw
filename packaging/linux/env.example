# /etc/picoclaw/env — secrets and runtime knobs for picoclaw.service
#
# Install a COPY of this file at /etc/picoclaw/env, then:
#     sudo chmod 0640 /etc/picoclaw/env
#     sudo chown root:picoclaw /etc/picoclaw/env
#     sudo systemctl restart picoclaw
#
# systemd reads this via EnvironmentFile=-/etc/picoclaw/env. Plain KEY=value
# only: no `export`, no shell expansion, no command substitution. Quote nothing
# that you do not literally want in the value.
#
# This file is NOT world-readable by design — the gateway holds provider API
# keys and chat-channel tokens.

# --- LLM provider (pick one) ------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# GEMINI_API_KEY=xxxxxxxxxxxxxxxx
# MODELSCOPE_API_KEY=xxxxxxxxxxxxxxxx

# --- Chat channels (pick any) ----------------------------------------------
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxx
# DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxx
# PICOCLAW_CHANNELS_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# PICOCLAW_CHANNELS_FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# --- Optional web search ----------------------------------------------------
# BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxx

# --- Timezone ---------------------------------------------------------------
# The unit sets TZ=UTC. Set your real zone here so cron jobs and memory
# timestamps line up with your day:
# TZ=Europe/Berlin

# --- Paths (only if you move things off the defaults) -----------------------
# PICOCLAW_HOME=/var/lib/picoclaw
# PICOCLAW_CONFIG=/var/lib/picoclaw/config.json
# PICOCLAW_GATEWAY_HOST=127.0.0.1
# PICOCLAW_GATEWAY_PORT=18790
# PICOCLAW_LOG_LEVEL=info
