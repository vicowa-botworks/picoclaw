[Unit]
Description=PicoClaw gateway
Documentation=https://docs.picoclaw.io/
After=network-online.target
Wants=network-online.target

# The gateway needs a configured default model to start. On a freshly flashed
# card that is the normal state, so gate the unit on the config file rather
# than crash-looping: `systemctl status picoclaw` then reports
# "Condition result was false", which is the cue to run `picoclaw onboard`.
#
# Override this in a drop-in if you point PICOCLAW_CONFIG (or PICOCLAW_HOME)
# somewhere else:  systemctl edit picoclaw.service
ConditionPathExists=/var/lib/picoclaw/config.json

[Service]
Type=simple
User=picoclaw
Group=picoclaw

# All picoclaw state (config, workspace, skills, sessions, logs, pid file)
# hangs off PICOCLAW_HOME. Keeping it outside any login user's home means the
# service does not care what the Pi's account is called.
Environment=PICOCLAW_HOME=/var/lib/picoclaw
Environment=TZ=UTC
# API keys and channel tokens: OPENROUTER_API_KEY, TELEGRAM_BOT_TOKEN, ...
# See /etc/picoclaw/env.example. The leading "-" makes the file optional.
EnvironmentFile=-/etc/picoclaw/env

ExecStart=/usr/bin/picoclaw gateway

Restart=on-failure
RestartSec=5
# The gateway traps SIGTERM/SIGINT and drains its channels, so ask politely and
# give it room before systemd sends SIGKILL.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# NOTE: deliberately no `ExecStartPre=rm -f .picoclaw.pid`. The gateway keeps
# its own singleton lock in $PICOCLAW_HOME/.picoclaw.pid and already treats a
# stale file as stale, including re-checking that the recorded PID is really a
# picoclaw process after PID reuse. Deleting it pre-start would only defeat
# that guard. (The Docker entrypoint does delete it, because a container
# restart reuses a bind-mounted volume where the recorded PID is meaningless.)

# --- hardening -------------------------------------------------------------
# ProtectSystem=strict makes the whole filesystem read-only except
# ReadWritePaths. That is intentional: the agent's `exec` tool runs real
# commands as the picoclaw user, and this bounds the blast radius on a machine
# that also does other things. To relax, do not edit this file:
#   systemctl edit picoclaw.service   ->  [Service] ProtectSystem=full
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/picoclaw
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# AF_NETLINK is not optional: pkg/netbind calls net.InterfaceAddrs(), which
# Go implements over netlink on Linux. Dropping it breaks gateway binding.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
